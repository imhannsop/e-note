# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.
#
# NEXT_PUBLIC_* values are bundled into the browser and are visible to anyone
# using the site. Only put values there that are designed to be public.

# Supabase → Project Settings → API. Use either the legacy "anon"/"service_role" keys
# or the newer "publishable" (sb_publishable_…) / "secret" (sb_secret_…) keys.
#
# Project URL and anon/publishable key: public by design. This app's tables deny it
# everything (RLS on, no policies); it's only used for live updates and signed uploads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. service_role or sb_secret_… key: full database access.
# Never prefix with NEXT_PUBLIC_, never import in client components.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Signs the login cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=
