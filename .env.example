# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.
#
# NEXT_PUBLIC_* values are bundled into the browser and are visible to anyone
# using the site. Only put values there that are designed to be public.

# Supabase project URL and anon key (public by design; access is enforced by row-level security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Full database access: never prefix with NEXT_PUBLIC_, never import in client components.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Signs the login cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=
