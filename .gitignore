# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: real values never leave this machine; only the blank template is committed
.env*
!.env.example

# secrets and keys
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
id_rsa*
id_ed25519*
secrets/
credentials*.json
service-account*.json

# supabase CLI local state (holds project refs and tokens)
supabase/.temp/
supabase/.branches/

# local tool settings and scratch output
.claude/settings.local.json
*.local.json
*.log
*.sqlite
*.db
/screenshots/

# netlify
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts
